FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

SECRET_KEY=degistir-bunu-guclu-bir-anahtar-ile
DATABASE_URL=sqlite:///contextcraft.db

# LlamaIndex — embedding API (Faz 5)
# OpenRouter kullanıyorsanız: https://openrouter.ai/keys
# OPENROUTER_API_KEY ile aynı anahtar olabilir; boş bırakılırsa otomatik kullanılır.
LLAMAINDEX_API_KEY=
LLAMAINDEX_API_BASE=https://openrouter.ai/api/v1
LLAMAINDEX_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter — DeepSeek (Faz 6)
# İndeksleme + prompt için tek OpenRouter anahtarı yeterli olabilir.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=ContextCraft

# Faz 6 — opsiyonel reranking (varsayılan kapalı)
RERANK_ENABLED=false

# Opsiyonel: yükleme boyut limiti (byte). Boş bırakılırsa limit yok.
# MAX_CONTENT_LENGTH=524288000

# Faz 10 — avatar yükleme varsayılanı config.py içinde (2 MB, png/jpg/gif/webp)

# --- Docker / Production ---
# docker compose up ile çalıştırırken:
# - DATABASE_URL docker-compose.yml içinde PostgreSQL olarak tanımlıdır
# - FLASK_ENV=production otomatik ayarlanır
# - SECRET_KEY mutlaka güçlü bir değer olmalıdır
# GUNICORN_WORKERS=2
